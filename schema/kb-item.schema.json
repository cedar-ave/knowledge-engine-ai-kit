{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb:item:1.0.0",
  "title": "Knowledge base item frontmatter",
  "description": "Field shapes only. Allowed values for controlled fields come from the generated schema/vocab.enum.json.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "description",
    "resource",
    "captured-on",
    "concepts",
    "knowledge-types",
    "sample-questions",
    "capture"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(yt|li|slack|web):.+"
    },
    "type": {
      "enum": [
        "blog",
        "newsletter",
        "podcast",
        "channel",
        "docs-site",
        "portfolio",
        "website",
        "repo",
        "book",
        "course",
        "article",
        "episode",
        "video",
        "talk",
        "slide-deck",
        "docs-page",
        "linkedin-post",
        "linkedin-article",
        "slack-thread"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title-devised": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "format": "uri"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "guests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "slack-workspace": {
      "type": "string",
      "minLength": 1
    },
    "slack-channel": {
      "type": "string",
      "pattern": "^#"
    },
    "published": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "description": "W3CDTF: YYYY, YYYY-MM or YYYY-MM-DD"
    },
    "captured-on": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "description": "W3CDTF: YYYY, YYYY-MM or YYYY-MM-DD"
    },
    "length-min": {
      "type": "number",
      "minimum": 0
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 6
    },
    "genre": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "knowledge-types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "example-of": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 5
    },
    "lifecycle-stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "org-contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "doc-types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 8
    },
    "first-hand": {
      "type": "boolean"
    },
    "best": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "sample-questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "knowledge-type"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
          },
          "knowledge-type": {
            "type": "string",
            "minLength": 1
          },
          "genre": {
            "type": "string",
            "minLength": 1
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "first-hand": {
            "type": "boolean"
          }
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "related-pages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "shared-in": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "captured-text-sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture": {
      "enum": [
        "verbatim",
        "full-text",
        "partial",
        "summary-only",
        "extraction-failed",
        "bookmark"
      ]
    },
    "part-of": {
      "type": "string",
      "minLength": 1
    },
    "last-reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01])(T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]+)?)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9]))?)?)?$",
      "description": "Same key and pattern as manni:stewardship:1.2.0 last-reviewed. Date a human last reviewed the metadata."
    },
    "notion-url": {
      "type": "string",
      "format": "uri"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "knowledge-types": {
            "contains": {
              "const": "example"
            }
          }
        },
        "required": [
          "knowledge-types"
        ]
      },
      "then": {
        "required": [
          "example-of"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capture": {
            "const": "bookmark"
          }
        },
        "required": [
          "capture"
        ]
      },
      "then": {
        "properties": {
          "sample-questions": {
            "maxItems": 3
          },
          "type": {
            "enum": [
              "blog",
              "newsletter",
              "podcast",
              "channel",
              "docs-site",
              "portfolio",
              "website",
              "repo",
              "book",
              "course"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "segments"
              ]
            },
            {
              "required": [
                "captured-text-sha256"
              ]
            }
          ]
        }
      },
      "else": {
        "properties": {
          "sample-questions": {
            "minItems": 3
          },
          "type": {
            "enum": [
              "article",
              "episode",
              "video",
              "talk",
              "slide-deck",
              "docs-page",
              "linkedin-post",
              "linkedin-article",
              "slack-thread"
            ]
          },
          "lifecycle-stages": {
            "minItems": 1
          }
        },
        "required": [
          "lifecycle-stages"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "slack-thread"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "slack-workspace",
          "slack-channel"
        ]
      }
    }
  ],
  "additionalProperties": true
}
