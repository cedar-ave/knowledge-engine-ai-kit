{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb:tag-output:1.0.0",
  "title": "Model output contract for tagging one item (a patch, never a whole file)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patch",
    "confidence"
  ],
  "properties": {
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "description": "Frontmatter keys to set. Agents never set best or note.",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "title-devised": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 6
        },
        "genre": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "knowledge-types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "example-of": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 5
        },
        "lifecycle-stages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "org-contexts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "doc-types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "organizations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "guests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "first-hand": {
          "type": "boolean"
        },
        "sample-questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slug",
              "title",
              "knowledge-type"
            ],
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
              },
              "knowledge-type": {
                "type": "string",
                "minLength": 1
              },
              "genre": {
                "type": "string",
                "minLength": 1
              },
              "concepts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "organizations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "first-hand": {
                "type": "boolean"
              }
            }
          }
        },
        "published": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
          "description": "W3CDTF: YYYY, YYYY-MM or YYYY-MM-DD"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "description": "Body sections inserted by script. Captured text is never included.",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "key-takeaways": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tools-mentioned": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "articles-resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open-questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "new-entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "slug",
          "title"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tool",
              "person",
              "organization",
              "event",
              "series"
            ]
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "alt-labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "new-terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scheme",
          "label",
          "description"
        ],
        "properties": {
          "scheme": {
            "enum": [
              "topics",
              "docs-artifacts",
              "frameworks"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "broader": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}
